# Подключение к PostgreSQL (драйвер psycopg3)
# ЗАМЕНИТЕ ВАШ_ПАРОЛЬ на пароль пользователя postgres
DATABASE_URL=postgresql+psycopg://postgres:ВАШ_ПАРОЛЬ@localhost:5432/qoqo

# Отключить пул соединений: нужно на serverless, где процесс живёт от вызова
# к вызову. На Vercel включается само по переменной VERCEL.
DB_NULL_POOL=false

# Часовой пояс проекта
TIMEZONE=Asia/Almaty

# Секрет для подписи JWT. В проде обязательно заменить на случайную строку:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# Время жизни токена доступа, минут (по умолчанию 12 часов)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Разрешённые origin для CORS, через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Администратор. Заводится при первом запуске, если в базе нет ни одного
# администратора, — иначе войти в систему было бы некому: регистрации нет.
# Пароль задаётся один раз; дальше он меняется в самой системе, а переменная
# ни на что не влияет. Со значением из этого образца учётная запись НЕ создаётся:
# пароль из репозитория знают все.
SEED_OWNER_EMAIL=owner@qoqo.kz
SEED_OWNER_PASSWORD=

# Адрес фронтенда — из него собираются ссылки в письмах-приглашениях
FRONTEND_URL=http://localhost:5173
INVITE_EXPIRE_HOURS=72

# Почта для приглашений. Если SMTP_HOST пуст, письма не отправляются,
# а ссылка пишется в лог и возвращается администратору в ответе API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QoQo <noreply@qoqo.kz>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Хранилище загруженных файлов. Пока S3_BUCKET пуст, файлы лежат на диске
# в каталоге MEDIA_ROOT и раздаются по /media. Для serverless бакет обязателен:
# локального диска, переживающего вызов, там нет.
MEDIA_ROOT=media
S3_BUCKET=
# Для AWS оставить пустым, для R2/MinIO — адрес API хранилища
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Адрес, по которому файлы читает браузер: CDN или сам бакет
S3_PUBLIC_URL=

# Включить SQL-логи и режим отладки
DEBUG=true

# Накатывать миграции при старте приложения. Для своей машины и своего
# сервера — удобно. На serverless игнорируется. Оставьте пустым, если
# схему накатывает CI или человек руками.
RUN_MIGRATIONS_ON_START=

# Телеграм-бот для уведомлений. Пусто — привязка в интерфейсе не предлагается.
# Токен выдаёт @BotFather.
TG_TOKEN=
# Имя бота для ссылки t.me/<имя>. Пусто — спросим у самого Telegram.
TG_BOT_USERNAME=
TG_LINK_CODE_TTL_MINUTES=15
# Секрет вебхука: Telegram присылает его заголовком, а не в адресе — адреса
# запросов пишут в свои журналы и nginx, и балансировщики. Нужен только в
# боевом контуре; получить строку: python -m app.scripts.telegram_webhook set <адрес>
TG_WEBHOOK_SECRET=
