# Подключение к PostgreSQL (драйвер psycopg3)
# ЗАМЕНИТЕ ВАШ_ПАРОЛЬ на пароль пользователя postgres
DATABASE_URL=postgresql+psycopg://postgres:ВАШ_ПАРОЛЬ@localhost:5432/qoqo

# Часовой пояс проекта
TIMEZONE=Asia/Almaty

# Секрет для подписи JWT. В проде обязательно заменить на случайную строку:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# Время жизни токена доступа, минут (по умолчанию 12 часов)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Разрешённые origin для CORS, через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Учётные данные владельца для сид-скрипта
SEED_OWNER_EMAIL=owner@qoqo.kz
SEED_OWNER_PASSWORD=owner12345

# Включить SQL-логи и режим отладки
DEBUG=true
